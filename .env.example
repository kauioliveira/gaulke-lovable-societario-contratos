# Copie para .env e preencha. O .env não é versionado.

# ---------- OpenAI (obrigatório) ----------
# Crie a chave em https://platform.openai.com/api-keys
# Sem ela o aplicativo não abre — a extração de dados é a razão de existir dele.
OPENAI_API_KEY=

# Modelo usado na leitura dos documentos.
# Precisa suportar visão (PDF/imagem) e structured outputs.
OPENAI_MODEL=gpt-5.4

# ---------- OpenAI (opcionais) ----------
# Endpoint alternativo (proxy corporativo, Azure OpenAI, gateway próprio).
OPENAI_BASE_URL=https://api.openai.com/v1

# Tempo máximo de uma chamada à IA, em milissegundos.
# Lotes com vários PDFs grandes demoram; 120s costuma bastar.
OPENAI_TIMEOUT_MS=120000

# ---------- LibreOffice (opcional) ----------
# Necessário apenas para aceitar modelos de contrato em .doc (Word 97-2003),
# que são convertidos para .docx antes do processamento.
# Vazio = usa `soffice` do PATH.
LIBREOFFICE_BIN=
